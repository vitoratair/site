# Copia para .env.locaweb e preenche (o ficheiro .env.locaweb não deve ir para o git).
# Dados FTP: painel Locaweb → Administrar site → Arquivos e FTP

# --- Opção A: FTP (predefinido em scripts/publish-locaweb.sh) ---
LOCAWEB_PUBLISH_METHOD=ftp
LOCAWEB_FTP_HOST=ftp.seudominio.com.br
LOCAWEB_FTP_USER=seu_usuario_ftp
LOCAWEB_FTP_PASSWORD=sua_senha_ftp
# Pasta no servidor, relativa ao login FTP (NÃO uses /home/usuario/... — dá erro 550).
# Hospedagem Linux: em geral public_html. Windows na Locaweb: web
LOCAWEB_REMOTE_DIR=public_html

# Se public_html tiver APENAS este site: apaga no servidor ficheiros que já não existem em dist/
# (ex.: assets/index-HASHantigo.js). Perigoso se tiveres outras pastas/ficheiros à mão na mesma raiz.
# LOCAWEB_FTP_DELETE_UNUSED=1

# --- Opção B: SSH + rsync (se tens SSH ativo no painel "SSH") ---
# LOCAWEB_PUBLISH_METHOD=rsync
# LOCAWEB_SSH_HOST=seudominio.com.br
# LOCAWEB_SSH_USER=seu_usuario_ssh
# Caminho absoluto ou ~/public_html conforme o que o suporte indicar
# LOCAWEB_SSH_PATH=~/public_html
# Opcional: apagar no servidor ficheiros que já não existem em dist/ (cuidado)
# LOCAWEB_RSYNC_DELETE=0
