# Apache (hospedagem Linux Locaweb): este ficheiro vai para a raiz do site com `npm run build`.
# Envie para public_html o *conteúdo* de dist/ (index.html, .htaccess, assets/, images/, etc.).
#
# HTTPS: no painel Locaweb ativa o certificado (ex.: Let's Encrypt) para o domínio; depois faz
# novo deploy para subir este .htaccess. O redirecionamento abaixo só funciona com SSL ativo.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

DirectoryIndex index.html

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Módulos ES e CSS — evita página em branco se .js for servido com MIME errado.
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
</IfModule>
