# Apache (hospedagem Linux Locaweb): este ficheiro vai para a raiz do site com `npm run build`.
# Envie para public_html o *conteúdo* de dist/ (index.html, .htaccess, assets/, images/, etc.).
#
# HTTPS direto na Locaweb: ativa SSL no painel e podes usar o redirecionamento abaixo.
# Cloudflare (proxy laranja + SSL "Flexible"): o visitante usa HTTPS na Cloudflare; a Locaweb
# recebe HTTP. O header CF-Connecting-IP existe nesses pedidos — não redirecionar para https
# no Apache evita loop (ERR_TOO_MANY_REDIRECTS). Ativa "Always Use HTTPS" na Cloudflare.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Sistema antigo (/auth/...) → raiz (301; ajuda a substituir redirects antigos em cache do browser)
  RewriteRule ^auth(?:/.*)?$ / [R=301,L]

  # HTTPS quando não vem da Cloudflare (SSL Flexible)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:CF-Connecting-IP} ^$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Ficheiros e pastas reais (assets, images, index.html, …) — não reescrever
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outro URL → SPA (mostra o site em vez de 404 Apache)
  RewriteRule ^ index.html [L]
</IfModule>

DirectoryIndex index.html

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Módulos ES e CSS — evita página em branco se .js for servido com MIME errado.
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
</IfModule>

# Cache: após deploy, o risco de “versão antiga” vem sobretudo do index.html em cache no browser
# ou numa CDN. Os JS/CSS do Vite têm hash no nome — cache longo é seguro.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "max-age=0, must-revalidate, private"
  </Files>
</IfModule>
<IfModule mod_setenvif.c>
  <IfModule mod_headers.c>
    SetEnvIf Request_URI "^/assets/.*\.(js|mjs|css)$" VITE_HASHED_ASSET=1
    Header set Cache-Control "public, max-age=31536000, immutable" env=VITE_HASHED_ASSET
  </IfModule>
</IfModule>
